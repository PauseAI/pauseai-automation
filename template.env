# public
AIRTABLE_BASE_ID="YOUR_AIRTABLE_BASE_ID"
AIRTABLE_TABLE_ID="YOUR_AIRTABLE_TABLE_NAME"
PAYMENT_STATUS_FIELD_NAME="YOUR_PAYMENT_STATUS_FIELD_NAME"
STRIPE_PRODUCT_ID="YOUR_STRIPE_PRODUCT_ID"
# The Airtable field holding the Tally submission id that subscriptions started before 2026-07-16 carry; defaults to "Tally ID"
# TALLY_ID_FIELD_NAME="Tally ID"
# CiviCRM base URL, e.g. https://crm.example.org; leave unset with the key below to write to Airtable only
# CRM_URL="YOUR_CRM_URL"
# 1 makes the paying sync read, diff and log only, writing nothing
# PAYING_SYNC_DRY_RUN="1"
# An ISO time at most 24 hours ahead that lifts the Airtable untick guard until then
# PAYING_SYNC_AIRTABLE_ALLOW_REMOVALS_UNTIL="2026-01-01T00:00:00Z"

# private
AIRTABLE_API_KEY="YOUR_AIRTABLE_API_KEY"
STRIPE_API_KEY="YOUR_STRIPE_API_KEY"
# API key of the CRM's stripe-webhook API account (its `paying` service account)
# CRM_STRIPE_WEBHOOK_KEY="YOUR_CRM_STRIPE_WEBHOOK_KEY"
